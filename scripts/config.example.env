# Copy to config.env and fill in. NEVER commit real credentials.
#   cp scripts/config.example.env config.env && set -a && . ./config.env && set +a

# REI BlackBook login (the account whose leads you're working)
REI_EMAIL=you@example.com
REI_PASSWORD=your-password

# Which day to process (YYYY-MM-DD). Omit to default to today.
# TARGET_DAY=2026-07-07

# Whisper model: base.en (faster) or small.en (more accurate for phone audio)
WMODEL=small.en

# Where the logged-in browser session is cached (keep it out of git).
REI_PROFILE_DIR=.rei-profile

# --- Sandbox/proxy only (leave unset on a normal machine) ---
# HTTPS_PROXY=http://127.0.0.1:PORT
# NODE_EXTRA_CA_CERTS=/path/to/proxy-ca-bundle.crt
# CHROMIUM_PATH=/opt/pw-browsers/chromium-XXXX/chrome-linux/chrome
