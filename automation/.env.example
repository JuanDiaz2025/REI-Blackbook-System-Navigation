# Post-Visit Auto-Debrief — standalone (Mode A) configuration.
# Copy to .env and fill in. Never commit the real .env.

# --- REI BlackBook (have these) ---
REI_EMAIL=bryan@twinhomebuyer.com
REI_PASSWORD=
# Where the reusable REI session is cached between runs:
REI_SESSION_PATH=/var/lib/postvisit/rei_session.pkl

# --- Google (Calendar + Drive + Gmail share one OAuth client) ---
# Create an OAuth client in Google Cloud Console; authorize once to get a token.
GOOGLE_OAUTH_CLIENT_JSON=/path/to/client_secret.json
GOOGLE_TOKEN_PATH=/var/lib/postvisit/google_token.json
# Scopes: calendar.readonly, drive.readonly, gmail.send

# --- Voicenotes ---
VOICENOTES_API_TOKEN=

# --- Claude (summarization) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- KPI logging ---
TRACKING_SHEET_ID=            # Google Sheet id for "Property Visit Tracking"

# --- Escalation notifications ---
ESCALATION_TO=juan@twinhomebuyer.com

# --- Run behavior ---
POLL_INTERVAL_MINUTES=30
DRY_RUN=true                  # keep true until the first approved live write
